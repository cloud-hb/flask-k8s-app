          "name": "GET /search (info)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is JSON\", function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "",
                  "pm.test(\"Method is GET\", function () {",
                  "    pm.expect(jsonData.method).to.eql(\"GET\");",
                  "});",
                  "",
                  "pm.test(\"GET search is not safe\", function () {",
                  "    pm.expect(jsonData.safe).to.eql(false);",
                  "});",
                  "",
                  "pm.test(\"Response instructs the client to use POST or QUERY\", function () {",
                  "    pm.expect(jsonData.message).to.eql(",
                  "        \"Use POST or QUERY with a JSON request body\"",
                  "    );",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/search",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "search"
              ]
            },
            "description": "Returns info that GET is not safe; use POST or QUERY with JSON body."
